modules = ["nodejs-24", "python-base-3.13", "rust-stable"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "gtk3", "nss", "atk", "cups", "libdrm", "mesa", "pango", "alsa-lib", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libXrender", "xorg.libxcb", "xorg.libXScrnSaver", "xorg.libXi", "xorg.libXtst", "xorg.libxshmfence", "libgbm", "libglvnd", "libxkbcommon", "xorg.xvfb", "xorg.xauth", "p7zip"]

[userenv]

[userenv.shared]
SONORA_APPROVER_EMAIL = "aishwarya@wavey18.com"
SONORA_OWNER_EMAIL = "accounts@tekgalaxysolutions.com"
